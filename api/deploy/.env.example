# Configuracao do DataRepo (lida pelo docker-compose.app.yml).
# As referencias de imagem NAO ficam aqui: ficam em .env.images.

# --- Banco (ja existente; nao e criado pela composicao) ------------------------
# Precisa ser alcancavel de DENTRO dos containers. Postgres no proprio host,
# publicado numa porta (caso do banco do monolito, em 5433):
#   postgresql://user:password@host.docker.internal:5433/data_app
# Postgres em outra maquina: use o host/IP dela.
DATABASE_URL=postgresql://user:password@host.docker.internal:5433/data_app
LOCAL_SCHEMA=public

# --- Segredos compartilhados entre servicos -----------------------------------
# Required — assina (api) e verifica (api e ingestion) o JWT.
JWT_SECRET=change-me-use-a-strong-random-value

# Required — autentica o envio de eventos de auditoria do ingestion para o api
# (POST /internal/v1/events). Gere com: openssl rand -hex 32
INTERNAL_API_TOKEN=change-me-use-a-strong-random-value

# --- api: usuarios e e-mail ---------------------------------------------------
# Initial admin credentials seeded on first startup (when _system_users is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Required for the "forgot my password" flow — corporate Office 365 relay.
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change-me

# Public origin used to build the password reset link (e.g. http://db.internal:5173).
# When empty the origin is taken from the request Host.
APP_BASE_URL=

# --- api: conexoes externas ---------------------------------------------------
# Required — encrypts external-DB connection passwords stored in _system_connections.
# Either a Fernet key (44-char base64url ending in '=') or any passphrase >= 32 chars.
CONNECTIONS_ENCRYPTION_KEY=change-me-32-chars-minimum-value
